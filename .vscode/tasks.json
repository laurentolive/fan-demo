{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build host32",
            "type": "shell",
            "command": "C:/Dev/Tools/make.exe TOOLCHAIN=host32",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "build host64",
            "type": "shell",
            "command": "C:/Dev/Tools/make.exe TOOLCHAIN=host64",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "e2sim connect host32",
            "detail": "GUI waiting for the firmware launched by the debugger (ends with the debug session)",
            "type": "shell",
            "command": "python .tools/e2Sim/e2sim_cli.py gui sim/hmi.board.yaml --toolchain host32 --connect 47600 --power-on",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^x^"
                },
                "background": {
                    "activesBegin": "^e2sim: waiting",
                    "endsPattern": "^e2sim: waiting"
                }
            }
        },
        {
            "label": "debug host32",
            "detail": "build, then the GUI waiting for the firmware (F5 preLaunchTask)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build host32",
                "e2sim connect host32"
            ]
        },
        {
            "label": "e2sim connect host64",
            "detail": "GUI waiting for the firmware launched by the debugger (ends with the debug session)",
            "type": "shell",
            "command": "python .tools/e2Sim/e2sim_cli.py gui sim/hmi.board.yaml --toolchain host64 --connect 47600 --power-on",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^x^"
                },
                "background": {
                    "activesBegin": "^e2sim: waiting",
                    "endsPattern": "^e2sim: waiting"
                }
            }
        },
        {
            "label": "debug host64",
            "detail": "build, then the GUI waiting for the firmware (F5 preLaunchTask)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "build host64",
                "e2sim connect host64"
            ]
        },
        {
            "label": "test",
            "type": "shell",
            "command": "C:/Dev/Tools/make.exe test",
            "group": "test"
        }
    ]
}
